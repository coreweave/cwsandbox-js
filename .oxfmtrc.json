{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "packages/*/dist/**",
    "packages/cwsandbox/src/transports/node-grpc/generated/**"
  ],
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "sortImports": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false
}
