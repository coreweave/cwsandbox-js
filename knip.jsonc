{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Same-file helpers stay exported; fail only when they become unused internally too.
  "ignoreExportsUsedInFile": true,
  // Generated proto surface is not hand-written debt.
  "ignore": ["packages/cwsandbox/src/transports/node-grpc/generated/**"],
  "ignoreIssues": {
    // Named + default export is the public ComputeSDK provider API.
    "packages/cwsandbox-computesdk/src/index.ts": ["duplicates"],
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.{ts,js}",
        "e2e/scripts/*.{js,py}",
        "e2e/**/*.e2e.test.ts",
        "vitest.*.config.ts",
      ],
    },
    "packages/cwsandbox": {
      "entry": ["src/**/*.test-d.ts"],
    },
  },
}
