{
  "name": "@coreweave/cwsandbox",
  "version": "0.5.0-beta.0",
  "description": "TypeScript SDK for CoreWeave Sandbox.",
  "keywords": [
    "coreweave",
    "sandbox"
  ],
  "homepage": "https://github.com/coreweave/cwsandbox-js/tree/main/packages/cwsandbox#readme",
  "bugs": {
    "url": "https://github.com/coreweave/cwsandbox-js/issues"
  },
  "license": "Apache-2.0",
  "author": "CoreWeave, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coreweave/cwsandbox-js.git",
    "directory": "packages/cwsandbox"
  },
  "source": "./src/index.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE-Apache-2.0.txt",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./wandb": {
      "types": "./dist/wandb/index.d.ts",
      "import": "./dist/wandb/index.js",
      "default": "./dist/wandb/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "proto:update": "buf generate buf.build/coreweave/sandbox:183ca230ae974ff7994e37861cb8b22d --template buf.gen.yaml --path coreweave/sandbox/v1/sandbox.proto --path coreweave/sandbox/v1/sandbox_data_plane.proto && tsx scripts/postprocess-generated.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:types": "vitest run --typecheck.only --config vitest.config.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@peculiar/x509": "^2.0.0",
    "@protobuf-ts/grpc-transport": "^2.11.1",
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
