{
  "name": "@coreweave/cwsandbox-computesdk",
  "version": "0.1.0-beta.0",
  "description": "CoreWeave Sandbox provider for ComputeSDK.",
  "keywords": [
    "computesdk",
    "coreweave",
    "cwsandbox",
    "provider",
    "sandbox"
  ],
  "homepage": "https://github.com/coreweave/cwsandbox-js/tree/main/packages/cwsandbox-computesdk#readme",
  "bugs": {
    "url": "https://github.com/coreweave/cwsandbox-js/issues"
  },
  "license": "Apache-2.0",
  "author": "CoreWeave, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coreweave/cwsandbox-js.git",
    "directory": "packages/cwsandbox-computesdk"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-Apache-2.0.txt",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "smoke": "pnpm --workspace-root test:e2e -- e2e/smoke/computesdk.e2e.test.ts"
  },
  "dependencies": {
    "@coreweave/cwsandbox": "workspace:*"
  },
  "devDependencies": {
    "@computesdk/provider": "^2.1.5",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@computesdk/provider": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
