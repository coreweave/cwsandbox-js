{
  "name": "@coreweave/cwsandbox-tanstack",
  "version": "0.1.0-beta.0",
  "private": true,
  "description": "TanStack AI sandbox provider for CoreWeave Sandbox.",
  "license": "Apache-2.0",
  "author": "CoreWeave, Inc.",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fix": "pnpm lint:fix && pnpm format:fix",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@coreweave/cwsandbox": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/ai-sandbox": "^0.2.3"
  },
  "peerDependencies": {
    "@tanstack/ai-sandbox": "^0.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
